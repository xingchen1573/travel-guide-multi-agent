# 可选：把 projects/、data/ 和 runtime/ 的读写根统一指向仓库外；不设置时继续使用
# 仓库内原目录。必须在启动 Python 进程前设置，已有文件不会自动复制。
# TRAVEL_GUIDE_RUNTIME_ROOT=/absolute/path/to/travel-runtime

# 模型API（OpenAI兼容端点，通过langchain-openai的ChatOpenAI调用；如果换成Anthropic原生API，改用get_chat_model里对应的client即可）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 可选：多个key逗号分隔，遇到429限流(rpm exhausted)时自动换下一个key重试
# （见 src/llm_rotation.py + docs/ISSUES.md）。不设置时只用上面的 LLM_API_KEY 单key，
# 行为完全不变，不是必填项。
# LLM_API_KEYS=key1,key2,key3

# 可选：多模态模型名（用户提交图文素材时描述图片用，见 src/materials/collectors/user_submit.py、
# run_submit_material.py）。跟上面LLM_MODEL共用同一个relay端点/LLM_API_KEY(S)，只是换模型名，
# 不需要单独申请key。不设置时默认 sensenova-6.7-flash-lite（SenseNova的轻量多模态模型）。
# LLM_VISION_MODEL=sensenova-6.7-flash-lite

# 可选：轻量模型名（简单分类/固定字段抽取用，如从一句话抽取destination/days等字段、
# 陪伴阶段问题路由到哪个agent，见 src/config.py 的 get_light_chat_model）。跟上面
# LLM_MODEL共用同一个relay端点/LLM_API_KEY(S)，同样支持429限流自动换key轮询。
# 不设置时默认 sensenova-6.7-flash-lite——这类任务不需要用重量级对话模型，用更便宜的
# 模型即可，核心内容生成/引用真实性核验等环节仍然用LLM_MODEL，不受这个变量影响。
# LLM_LIGHT_MODEL=sensenova-6.7-flash-lite

# 可选：对话模型请求超时（秒），默认600。飞书WS worker和长工具调用场景下，模型客户端如果
# 没有显式超时，上游一旦变慢会导致整条对话链路无限期挂起（`docs/reference-archives/2026-07-feishu-integration-lessons.md` 记录的外部项目教训）。
# CHAT_MODEL_TIMEOUT_SECONDS=600

# 可选：轻量分类/抽取模型的单次请求超时（秒），默认60。这类请求通常数秒完成，
# 不继承长攻略模型的600秒窗口，避免一次标题分类异常拖住整个工作流。
# LIGHT_MODEL_TIMEOUT_SECONDS=60

# Embedding API（素材库向量检索用，独立于上面的对话模型provider，因为不是每个relay端点都提供embeddings接口）
# 当前用硅基流动的 BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 高德MCP（路线规划agent / 衣食住行agent 用于结构化校验）
AMAP_MCP_ENDPOINT=
AMAP_MCP_API_KEY=

# 森林页真实地图（呈现层P2第一项，2026-07-24接入，见 src/tools/geocode.py、
# run_generate_site.py）。跟上面AMAP_MCP_API_KEY是不同用途、需要分别申请的两种key
# （高德开放平台"应用管理"下同一个应用可以加多个key）：
# - AMAP_GEOCODE_API_KEY：Web服务API类型，服务端调地理编码接口（POI名称->经纬度）。
# - AMAP_JS_API_KEY：Web端(JS API)类型，前端网页里加载地图画点位用，申请时需要配置
#   referer白名单（本地测试可以留空或填*，正式部署时建议限制成实际域名）。
# 两者均为免费额度，个人开发者认证即可，不需要企业资质。未配置时地图区域降级为
# POI列表展示，跟AMAP_MCP_API_KEY同一种优雅降级模式，不阻塞run_generate_site.py。
AMAP_GEOCODE_API_KEY=
AMAP_JS_API_KEY=
# AMAP_JS_SECURITY_CODE：高德2021年底起JS API强制要求的"安全密钥"，跟AMAP_JS_API_KEY
# 是同一个key的配套密钥（申请Web端(JS API)类型key时控制台会一并显示）。不配置会导致
# 地图加载报INVALID_USER_SCODE安全校验失败——这跟其他key不完全是同一种降级模式（未配置
# AMAP_JS_API_KEY时直接走POI列表降级，但配了AMAP_JS_API_KEY却漏配这个会显式报错而不是
# 优雅降级，需要用户自己注意）。跟JS Key一样是暴露在前端HTML里的公开凭证，不是敏感的
# 服务端密钥。
AMAP_JS_SECURITY_CODE=

# 素材源相关配置（v1暂不需要，先用离线解析好的文本测试；v2接入抖音/小红书时再补充）
# BILIBILI_COOKIE=
# DOUYIN_API_KEY=
# XIAOHONGSHU_API_KEY=

# 实时API（v2 实时agent使用，v1.17起已接入web_search，见下方TAVILY_API_KEY）
# REALTIME_API_KEY=

# Tavily搜索API（实时agent的web_search工具，查天气/营业状态/最新事件等需要联网的
# 时效性信息，2026-07-22接入）。未配置时web_search工具走stub降级、不阻塞主流程，
# 跟AMAP_MCP_API_KEY同一种模式。免费额度注册：https://tavily.com/
TAVILY_API_KEY=
# 可选：多个key逗号分隔，遇到429限流/额度耗尽时自动换下一个key重试
# （见 src/tools/web_search_tools.py，跟上面 LLM_API_KEYS 同一个动机）。
# 不设置时只用上面的 TAVILY_API_KEY 单key，不是必填项。
# TAVILY_API_KEYS=key1,key2

# 小米 MiMo ASR（B站/抖音采集pipeline转写音轨用，见 sandbox/mimo_asr/、
# src/materials/collectors/bilibili.py）——2026-08-04起降级为兜底渠道，ASR主渠道改用
# 下面的 SILICONFLOW_ASR_*。未配置硅基ASR key、或硅基调用失败时，pipeline自动回退到
# MiMo（保留 MiMo 的切片+dedup 兜底路径，因为 MiMo base64 有 10MB 硬限制+长序列退化）。
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# 可选：legacy 对话渠道的 OpenAI 兼容入口；仅配置 legacy key 时才需要显式填写。
MIMO_CHAT_BASE_URL=
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_CHAT_MODEL=mimo-v2.5
MIMO_PRO_CHAT_MODEL=mimo-v2.5-pro
# 可选：多个key逗号分隔，优先用列表首位，遇到限流/额度耗尽时自动换下一个key重试
# （见 src/config.py MIMO_API_KEYS，标准版和Pro共享这个key池）。后续接入gpt-load聚合
# 网关时，只需把MIMO_BASE_URL改为聚合地址并把不同额度key写入MIMO_API_KEYS。
# 不设置时只用上面的 MIMO_API_KEY 单key，不是必填项。
# MIMO_API_KEYS=key1,key2

# 可选：后续接入gpt-load聚合API。聚合服务内部管理不同余额的官方key；配置后该渠道
# GPTLOAD_CHAT_MODEL只决定Provider下实际使用的对话模型，不改变URL或Key池。
# GPTLOAD_CHAT_MODEL=glm-5.3-flash
# 排在MiMo token_plan和官方直连之前。未配置key时不会进入模型链。
MIMO_GPTLOAD_API_KEY=
MIMO_GPTLOAD_BASE_URL=
# MIMO_GPTLOAD_API_KEYS=key1,key2

# 可选：jiji.cc独立实验Provider。仅配置凭证不会改变默认模型链；启动某次进程时显式设置
# TRAVEL_MODEL_PROVIDER=jiji，长攻略与窄结构化核验才会统一走本组。
JIJI_API_KEY=
JIJI_BASE_URL=https://www.jiji.cc/v1
JIJI_CHAT_MODEL=glm-5.3-flash
# JIJI_API_KEYS=key1,key2
# TRAVEL_MODEL_PROVIDER=jiji

# 可选：仅用于POI首次生成在GPT-Load完整技术退避耗尽后的末级恢复渠道。
# Provider和模型独立配置；不加入其他Agent或结构化核验链。未配置时恢复保持旧GPT-Load行为。
OOIOO_API_KEY=
OOIOO_BASE_URL=https://ooioo.work/v1
OOIOO_CHAT_MODEL=deepseek-v4-flash
# OOIOO_API_KEYS=key1,key2

# 硅基流动 ASR（2026-08-04新增，ASR转写主渠道，MiMo作兜底；2026-08-24模型从
# TeleAI/TeleSpeechASR切到XingChenAGI/XingChenASR-V3.2-Ultra，同平台同接口）。跟
# SILICONFLOW_LLM_API_KEY / EMBEDDING_API_KEY 同一个平台（api.siliconflow.cn），但这是独立
# 申请的ASR key——ASR走 /v1/audio/transcriptions（Whisper风格multipart上传），跟对话/embedding
# 是不同接口、各自独立计费，不共用key。实测一次可吃20MB wav（10min视频）不需要切片、且
# 不像MiMo那样在长序列尾部退化复读。在 sandbox/mimo_asr/test_asr.py 里作为主渠道优先使用，
# 失败/未配置时回退到上面的 MiMo（transcribe_long.py 在硅基渠道下走整段直转、MiMo渠道下
# 才走原切片+dedup 路径）。跟EMBEDDING_BASE_URL同域，注册：https://siliconflow.cn
SILICONFLOW_ASR_API_KEY=
SILICONFLOW_ASR_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra
# 可选：多个key逗号分隔轮询（跟LLM_API_KEYS/MIMO_API_KEYS同一个动机）。不设置时只用上面
# 的 SILICONFLOW_ASR_API_KEY 单key，不是必填项。
# SILICONFLOW_ASR_API_KEYS=key1,key2

# CUN.AI 旧版一次性前端设计探索变量（只供 design/poi_detail_page/ 下的历史脚本使用，
# 不会被 src/config.py 的运行时模型工厂读取）。
CUN_AI_API_KEY=
CUN_AI_BASE_URL=https://www.cun.ai/v1/chat/completions

# cun.ai 直连对话渠道（group="cunai"）。当前定向复核 API / agentic review 默认使用
# 这个 group；跟上面的 CUN_AI_* 历史设计脚本变量不是同一套配置。
CUNAI_API_KEY=
CUNAI_BASE_URL=https://www.cun.ai/v1
CUNAI_CHAT_MODEL=deepseek-v4-flash-0731
# CUNAI_API_KEYS=key1,key2

# 概览海报生成（run_generate_poster.py）：不做联网搜图，直接用生图模型生成整张信息图
# 海报，默认选型 gpt-image-2，经 cun.ai 中转访问。该脚本是手动入口；未配置时会明确报错，
# 不属于主生成链的静默降级能力。
POSTER_IMAGE_API_KEY=
POSTER_IMAGE_BASE_URL=https://www.cun.ai/v1
POSTER_IMAGE_MODEL=gpt-image-2

# 飞书接入（v1第一期，WebSocket长连接，见run_feishu_worker.py、src/channels/feishu/、
# docs/ARCHITECTURE.md第14节）。飞书开放平台创建"企业自建应用"后，在"凭证与基础信息"里获取。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Webhook这次不支持（只做WS长连接），这两个变量仅供以后扩展Webhook时使用，当前
# ws_client.py传给EventDispatcherHandler.builder()但WS链路本身不依赖它们校验。
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 是否真实调用飞书API发送/编辑消息。false（默认）时只把消息内容打印到日志，不真实调用
# 飞书接口——本地开发/没有真实凭证时的降级模式，跟AMAP_MCP_API_KEY等"没有key不阻塞"
# 是同一类设计，但这里是显式开关而不是"没配key就降级"，因为FEISHU_APP_ID/APP_SECRET
# 就算配了，开发阶段可能也不想真的发消息到飞书群里。
FEISHU_ENABLE_REAL_SEND=false
# 单条消息最大字符数，超过按此长度切分成多条发送，默认3200。
# FEISHU_REPLY_CHAR_LIMIT=3200
# 跑图期间进度轮询间隔（秒），默认2.5——多久检查一次workspace/run_status.json并原地编辑
# 进度消息，而不是一直发新消息刷屏。
# FEISHU_PROGRESS_POLL_SECONDS=2.5

# 轻量级执行状态管理（见 docs/EXECUTION_STATE_MANAGEMENT.md）。默认数据库位于
# runtime/execution_state.sqlite3；pytest 自动使用临时库且默认关闭 FastAPI 维护线程。
# EXECUTION_STATE_DB=/absolute/path/to/execution_state.sqlite3
APP_ENVIRONMENT=default
# 通常无需设置；显式 false 可在特殊只读启动中关闭租约维护，生产默认开启。
# EXECUTION_MAINTENANCE_ENABLED=true
